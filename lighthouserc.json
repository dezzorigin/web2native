{
 "ci": {
  "assert": {
   "assertions": {
    "categories:performance": [
     "warn",
     {
      "minScore": 0.5
     }
    ],
    "categories:accessibility": [
     "error",
     {
      "minScore": 0.9
     }
    ],
    "categories:best-practices": [
     "error",
     {
      "minScore": 0.9
     }
    ],
    "categories:seo": [
     "warn",
     {
      "minScore": 0.9
     }
    ],
    "errors-in-console": [
     "error",
     {
      "minScore": 1
     }
    ]
   }
  },
  "collect": {
   "numberOfRuns": 2,
   "startServerCommand": "python3 -m http.server 8330 --directory out",
   "startServerReadyPattern": "Serving HTTP",
   "url": [
    "http://127.0.0.1:8330/index.html"
   ],
   "settings": {
    "chromeFlags": "--no-sandbox --disable-dev-shm-usage --ignore-certificate-errors"
   }
  },
  "upload": {
   "target": "temporary-public-storage"
  }
 }
}