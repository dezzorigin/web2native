# WEBTONATIVE_EMAIL — WAJIB.
# Email yang didaftarkan ke webtonative.com saat mengajukan build.
# Build tercatat atas email ini; notifikasi build dari webtonative.com
# masuk ke alamat ini. Isi dengan email pemilik produk.
# Di Cloudflare Pages, set sebagai env var project (bukan di repo).
# Kalau kosong, POST /api/build menjawab 503.
WEBTONATIVE_EMAIL=you@example.com
